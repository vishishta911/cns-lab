import java.math.BigInteger;
import java.security.SecureRandom;
import java.util.*;
public class ElGamal {
    static BigInteger p, g, x, y;
    static SecureRandom r = new SecureRandom();
    static {
        p = BigInteger.probablePrime(512, r);
        g = new BigInteger(511, r).mod(p);
        x = new BigInteger(511, r).mod(p);
        y = g.modPow(x, p);
    }
    static BigInteger[] encrypt(BigInteger m) {
        BigInteger k = new BigInteger(511, r).mod(p);
        return new BigInteger[]{g.modPow(k, p), m.multiply(y.modPow(k, p)).mod(p)};
    }
    static BigInteger decrypt(BigInteger[] c) {
        BigInteger s = c[0].modPow(x, p);
        return c[1].multiply(s.modInverse(p)).mod(p);
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Public Key: (p=" + p + ", g=" + g + ", y=" + y + ")");
        System.out.println("Private Key: x=" + x);
        System.out.print("Enter message to encrypt (numeric value): ");
        BigInteger m = sc.nextBigInteger();
        System.out.println("Original Message: " + m);
        BigInteger[] c = encrypt(m);
        System.out.println("Cipher Text: (" + c[0] + ", " + c[1] + ")");
        System.out.println("Decrypted Message: " + decrypt(c));
        sc.close();
    }
}


