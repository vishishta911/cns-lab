import java.security.*;
import java.util.*;
public class MD5Hash {
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter input1 string for MD5: ");
        String input1 = sc.nextLine();
        System.out.println("MD5 Hash for input1: " + hash(input1));
        System.out.print("Enter input2 with small change in the string : ");
        String input2 = sc.nextLine();
        System.out.println("MD5 Hash for input2: " + hash(input2));
        sc.close();
    }
    static String hash(String s) throws Exception {
        byte[] b = MessageDigest.getInstance("MD5").digest(s.getBytes());
        StringBuilder sb = new StringBuilder();
        for (byte x : b) sb.append(String.format("%02x", x));
        return sb.toString();
    }
}
