import java.security.*;
import java.util.*;

public class SHA1Hash {
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter first input string for SHA-1: ");
        String input1 = sc.nextLine();
        System.out.print("Enter second input string with a small change: ");
        String input2 = sc.nextLine();

        System.out.println("SHA-1 Hash of '" + input1 + "': " + hash(input1));
        System.out.println("SHA-1 Hash of '" + input2 + "': " + hash(input2));

        sc.close();
    }

    static String hash(String s) throws Exception {
        byte[] b = MessageDigest.getInstance("SHA-1").digest(s.getBytes());
        StringBuilder sb = new StringBuilder();
        for (byte x : b) sb.append(String.format("%02x", x));
        return sb.toString();
    }
}
